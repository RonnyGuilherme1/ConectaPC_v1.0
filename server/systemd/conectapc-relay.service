[Unit]
Description=ConectaPC Rendezvous/Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conectapc
Group=conectapc
WorkingDirectory=/opt/conectapc-relay
EnvironmentFile=-/etc/conectapc/relay.env
ExecStart=/usr/bin/python3 /opt/conectapc-relay/relay_server.py --host 0.0.0.0 --port 443 --cert /etc/conectapc/relay.crt --key /etc/conectapc/relay.key --db /var/lib/conectapc/relay.db --audit-retention-days 90
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/conectapc
StateDirectory=conectapc
StateDirectoryMode=0750
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G
TasksMax=1024

[Install]
WantedBy=multi-user.target
