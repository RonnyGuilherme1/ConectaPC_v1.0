[Unit]
Description=ConectaPC Rendezvous/Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conectapc
Group=conectapc
WorkingDirectory=/opt/conectapc-relay
ExecStart=/usr/bin/python3 /opt/conectapc-relay/relay_server.py --host 0.0.0.0 --port 443 --cert /etc/conectapc/relay.crt --key /etc/conectapc/relay.key
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/conectapc
MemoryMax=1G

[Install]
WantedBy=multi-user.target
